common --noenable_bzlmod
build --incompatible_enable_cc_toolchain_resolution

build --compiler=compiler
test --compiler=compiler

build --cpu=stm32g4
test --cpu=stm32g4

# The firmware (the default build, no --config) selects the rules_mbed
# stm32g4 CC toolchain via Bazel's platform-based toolchain resolution.
# --cpu above is retained only for output-directory naming.
build --platforms=@com_github_mjbots_rules_mbed//:stm32g4
test --platforms=@com_github_mjbots_rules_mbed//:stm32g4

build --nostart_end_lib
test --nostart_end_lib

build -c opt
test -c opt

# The Raspberry Pi cross-compiles select the rpi_bazel CC toolchain via
# platform resolution.  --cpu is retained for the
# //:python*_{armeabihf,aarch64} config_settings (which pick the Python
# wheel ABI per architecture) and for output-directory distinctness.
build:pi --platforms=@rpi_bazel//:armeabihf
test:pi --platforms=@rpi_bazel//:armeabihf
build:pi --cpu=armeabihf
test:pi --cpu=armeabihf

build:pi64 --platforms=@rpi_bazel//:aarch64
test:pi64 --platforms=@rpi_bazel//:aarch64
build:pi64 --cpu=aarch64
test:pi64 --cpu=aarch64

# Host builds select the autodetected local CC toolchain via platform
# resolution.
build:host --platforms=@local_config_platform//:host
build:host --cpu=k8
build:host --linkopt=-lrt

build --workspace_status_command=tools/workspace_status.sh
test --workspace_status_command=tools/workspace_status.sh

build --stamp
test --stamp

test --test_output=errors
